# Contextline environment. Copy to `.env` and fill in your project id.
# Model calls go through Vertex AI with Application Default Credentials (ADC).
# One-time setup on this machine:
#   gcloud auth application-default login
#   gcloud config set project YOUR_PROJECT_ID
# No API keys anywhere.

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global

# Optional: override where Contextline stores its local data (default: ~/.contextline)
# CONTEXTLINE_HOME=/Users/you/.contextline
