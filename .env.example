# Contextline environment. Copy to `.env` and paste your key.
#
# Dev/test runs use a FREE-TIER Gemini Developer API key — no Google Cloud project,
# no billing, no gcloud. Create one in ~30 seconds at https://aistudio.google.com/apikey
# (Free-tier limits are per-day; plenty for dev because the on-disk cache makes reruns free.)

GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=PASTE_YOUR_FREE_AISTUDIO_KEY_HERE

# --- Legacy: Vertex AI + ADC (only needed if you deliberately want dev to bill a GCP
# --- project; the deployed relay server has its own credentials and ignores this file).
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
# GOOGLE_CLOUD_LOCATION=global

# NEVER set GOOGLE_GEMINI_BASE_URL here — google-genai honors it unconditionally and it
# would silently reroute dev model calls. It belongs only to the packaged app / relay tests.

# Optional: override where Contextline stores its local data (default: ~/.contextline)
# CONTEXTLINE_HOME=/Users/you/.contextline
